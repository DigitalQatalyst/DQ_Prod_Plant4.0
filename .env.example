# Supabase Configuration
# Get these values from your Supabase project settings: https://supabase.com/dashboard
VITE_SUPABASE_URL=your-project-url
VITE_SUPABASE_ANON_KEY=your-anon-key

# Data Backend Switch
# Options: "mock" | "supabase" | "hybrid"
# Use "mock" during development with legacy mock data
# Use "supabase" when ready to consume from Supabase
# Use "hybrid" for Power Transmission on Supabase + Upstream O&G on mocks
VITE_DATA_BACKEND=mock
